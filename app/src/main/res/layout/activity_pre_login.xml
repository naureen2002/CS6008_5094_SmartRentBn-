<?xml version="1.0" encoding="utf-8"?>

<!-- Using FrameLayout so i can layer background image, overlay, and content -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image for the welcome page -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/main"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="Background Image" />

    <!-- Dark overlay to make texts and buttons stand out -->
    <View
        android:id="@+id/dark_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Main content container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- App logo shown at the top -->
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/baseline_house_24"
            android:layout_gravity="center"
            android:contentDescription="App Logo" />

        <!-- App name text -->
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartRent BN"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/lavender"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- Login button -->
        <Button
            android:id="@+id/login_button_pre"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Login"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="60dp"
            android:backgroundTint="@color/lavender"
            app:cornerRadius="20dp"
            android:layout_marginHorizontal="30dp" />

        <!-- Signup button -->
        <Button
            android:id="@+id/signup_button_pre"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Sign Up"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/lavender"
            app:cornerRadius="20dp"
            android:layout_marginHorizontal="30dp" />

    </LinearLayout>
</FrameLayout>
