<?xml version="1.0" encoding="utf-8"?>

<!-- Main container for showing the tenant's applications list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Page title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Applications"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/lavender"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- Loading indicator shown while fetching data -->
    <ProgressBar
        android:id="@+id/progressBarApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- RecyclerView to display all applications submitted by tenant -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTenantApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
